# Copy this file to .env for local development.
# In production (Vercel), set these under Project → Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connection Details → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-endpoint-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Random secret used to sign session tokens. Generate one with:
#   npx auth secret      (or)      openssl rand -base64 32
AUTH_SECRET=""

# Do NOT set AUTH_URL in production. Auth.js detects the host automatically
# (trustHost is enabled). Setting it to localhost breaks login on the live site.
